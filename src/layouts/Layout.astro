---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBookingBar from '../components/StickyBookingBar.astro';
import ChatbotWidget from '../components/ChatbotWidget.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  structuredData?: Record<string, any>[];
  bodyClass?: string;
}

const { title, description, ogImage, noindex, breadcrumbs, structuredData = [], bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <SEO title={title} description={description} ogImage={ogImage} noindex={noindex} />
    <StructuredData breadcrumbs={breadcrumbs} extra={structuredData} />

    <slot name="head" />
  </head>
  <body class:list={['min-h-screen flex flex-col', bodyClass]}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-1 pt-[76px]">
      <slot />
    </main>
    <Footer />
    <StickyBookingBar />
    <ChatbotWidget />

    <script>
      import '../lib/client/reveal';
      import '../lib/client/interactions';
    </script>
  </body>
</html>
