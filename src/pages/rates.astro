---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import RateCard from '../components/RateCard.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const pageEntries = await getCollection('pages');
const page = pageEntries.find((p) => p.slug === 'rates')!;

const rates = (await getCollection('rates')).filter((r) => r.data.published).sort((a, b) => a.data.displayOrder - b.data.displayOrder);
const policies = await getCollection('policies');
const bookingRules = policies.find((p) => p.slug === 'booking-rules')!;
const { Content: BookingRulesContent } = await bookingRules.render();

function extractNumber(str: string, fallback: number) {
  const match = str.match(/[\d,]+/);
  return match ? Number(match[0].replace(/,/g, '')) : fallback;
}
const offPeak = rates.find((r) => r.id === 'off-peak-hourly');
const peak = rates.find((r) => r.id === 'peak-hourly');
const offPeakRate = extractNumber(offPeak?.data.price || '', 250);
const peakRate = extractNumber(peak?.data.price || '', 350);
---
<Layout
  title={page.data.seoTitle || page.data.title}
  description={page.data.metaDescription || page.data.description || ''}
  ogImage={page.data.ogImage}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Rates', url: '/rates' }]}
>
  <PageHero heading={page.data.heading} subheading={page.data.subheading} description={page.data.description} heroImage={page.data.heroImage} heroImageAlt={page.data.heroImageAlt} compact />

  <section class="py-20 sm:py-24">
    <div class="container-rc">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {rates.map((rate, i) => (
          <RateCard
            name={rate.data.name}
            description={rate.data.description}
            price={rate.data.price}
            billingUnit={rate.data.billingUnit}
            peakOrOffPeak={rate.data.peakOrOffPeak}
            features={rate.data.features}
            isPlaceholderPrice={rate.data.isPlaceholderPrice}
            featured={rate.data.featured}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24 bg-rc-charcoal/40">
    <div class="container-rc max-w-3xl mx-auto reveal">
      <div class="text-center mb-10">
        <p class="eyebrow mb-5 mx-auto w-fit">Try It Yourself</p>
        <h2 class="section-heading">Pricing Calculator</h2>
      </div>
      <PricingCalculator offPeakRate={offPeakRate} peakRate={peakRate} />
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="container-rc grid lg:grid-cols-2 gap-10">
      <div class="reveal">
        <h2 class="font-heading text-2xl font-bold text-rc-white mb-5 flex items-center gap-2">
          <Icon name="info" class="w-5 h-5 text-rc-lime" /> Booking Rules & Policies
        </h2>
        <div class="prose-rc card-surface p-7">
          <BookingRulesContent />
        </div>
      </div>
      <div class="reveal space-y-5" data-reveal-delay="100">
        <div class="card-surface p-6">
          <h3 class="font-heading font-bold text-rc-white mb-2">Payment Methods</h3>
          <p class="text-sm text-rc-silver">Accepted payment methods will be confirmed by our team when your booking is finalized. <span class="text-rc-lime/80 text-xs uppercase">(placeholder — update in CMS)</span></p>
        </div>
        <div class="card-surface p-6">
          <h3 class="font-heading font-bold text-rc-white mb-2">Cancellations, Rescheduling & Refunds</h3>
          <p class="text-sm text-rc-silver">See our full <a href="/cancellation-policy" class="text-rc-lime underline underline-offset-4">Cancellation & Rescheduling Policy</a> for cutoff windows and refund terms.</p>
        </div>
        <div class="card-surface p-6">
          <h3 class="font-heading font-bold text-rc-white mb-2">Late Arrivals</h3>
          <p class="text-sm text-rc-silver">Please arrive on time — sessions starting more than 15 minutes late without notice may be treated as a no-show per our cancellation policy.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-rc-gradient opacity-90"></div>
    <div class="container-rc relative text-center max-w-xl mx-auto reveal">
      <h2 class="section-heading mb-5">Need a Custom Package?</h2>
      <p class="text-white/85 mb-8">Corporate events, tournaments, and private bookings get custom pricing — just reach out.</p>
      <a href="/contact" class="btn-primary bg-white text-rc-black hover:bg-white/90" data-ripple data-magnetic>Contact Us</a>
    </div>
  </section>
</Layout>
