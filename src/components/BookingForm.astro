---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const addonEntries = (await getCollection('addons')).filter((a) => a.data.published).sort((a, b) => a.data.displayOrder - b.data.displayOrder);
const addons = addonEntries.map((a) => ({
  id: a.id,
  name: a.data.name,
  description: a.data.description || '',
  price: a.data.price,
  unit: a.data.unit,
}));

const steps = ['Schedule', 'Players & Options', 'Your Info', 'Review', 'Submit'];
---
<div id="booking-form-root" class="max-w-3xl mx-auto">
  <!-- Hidden static form so Netlify's build-time bot detects this form.
       Real submissions are sent via fetch() from booking-form.ts using the
       same field names/form-name so Netlify Forms captures every booking. -->
  <form name="booking" data-netlify="true" netlify-honeypot="bk-company" hidden>
    <input type="text" name="reference" />
    <input type="text" name="date" />
    <input type="text" name="startTime" />
    <input type="text" name="endTime" />
    <input type="text" name="duration" />
    <input type="text" name="players" />
    <input type="text" name="sessionType" />
    <input type="text" name="addons" />
    <input type="text" name="fullName" />
    <input type="text" name="mobile" />
    <input type="text" name="email" />
    <input type="text" name="city" />
    <input type="text" name="preferredContact" />
    <textarea name="specialRequests"></textarea>
    <input type="text" name="bk-company" />
  </form>

  <!-- Progress stepper -->
  <div class="mb-10">
    <div class="relative h-1.5 bg-white/10 rounded-full overflow-hidden mb-6">
      <div id="booking-progress-bar" class="absolute inset-y-0 left-0 bg-rc-gradient-lime rounded-full transition-all duration-500" style="width:0%"></div>
    </div>
    <div class="flex justify-between">
      {steps.map((label, i) => (
        <div class="flex flex-col items-center gap-2 flex-1" data-step-dot={i + 1}>
          <span class="bk-dot w-8 h-8 rounded-full border-2 border-white/20 flex items-center justify-center text-xs font-heading font-bold text-rc-silver-dark transition-colors">{i + 1}</span>
          <span class="hidden sm:block text-[10px] uppercase tracking-wide text-rc-silver-dark text-center">{label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Step 1: Schedule -->
  <section data-step-panel="1" class="card-surface p-6 sm:p-8">
    <h2 class="font-heading text-xl font-bold text-rc-white mb-1">Select Your Schedule</h2>
    <p class="text-sm text-rc-silver-dark mb-6">Open daily 6:00 AM – 3:00 AM. Slots after midnight are shown as part of the evening you select.</p>

    <label for="bk-date" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Date</label>
    <input type="date" id="bk-date" class="form-input max-w-xs mb-6" />

    <p id="bk-fully-booked" class="hidden rounded-lg border border-red-500/30 bg-red-500/10 text-red-300 text-sm px-4 py-3 mb-6">
      This date is fully booked. Please choose another date.
    </p>

    <div id="bk-slots-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2 mb-6"></div>

    <div class="grid sm:grid-cols-2 gap-5 mb-6">
      <div>
        <label for="bk-duration" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Duration</label>
        <select id="bk-duration" class="form-input"></select>
      </div>
      <div class="flex items-end">
        <span id="bk-peak-badge" class="hidden bk-badge"></span>
      </div>
    </div>

    <div class="rounded-lg bg-white/5 border border-white/10 px-4 py-3 text-sm text-rc-silver" id="bk-slot-summary">
      Select a start time to see your session details.
    </div>

    <div class="flex justify-end mt-8">
      <button type="button" class="btn-primary" data-step-next data-ripple>Continue <Icon name="arrow" class="w-4 h-4" /></button>
    </div>
  </section>

  <!-- Step 2: Players & Options -->
  <section data-step-panel="2" class="hidden card-surface p-6 sm:p-8">
    <h2 class="font-heading text-xl font-bold text-rc-white mb-6">Players & Options</h2>

    <div class="mb-7">
      <label for="bk-players" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Number of Players</label>
      <input type="number" id="bk-players" min="1" max="24" value="4" class="form-input max-w-[160px]" />
    </div>

    <fieldset class="mb-7">
      <legend class="text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-3">Session Type</legend>
      <div class="grid sm:grid-cols-3 gap-3">
        {['Casual Play', 'Open Play', 'Training', 'Tournament', 'Private Event'].map((type, i) => (
          <label class="bk-radio-card">
            <input type="radio" name="sessionType" value={type} checked={i === 0} />
            <span>{type}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-3">Add-ons (Paddle, Ball, Coaching & More)</legend>
      <div id="bk-addons" class="grid sm:grid-cols-2 gap-3"></div>
    </fieldset>

    <div class="flex justify-between mt-8">
      <button type="button" class="btn-ghost" data-step-back data-ripple>Back</button>
      <button type="button" class="btn-primary" data-step-next data-ripple>Continue <Icon name="arrow" class="w-4 h-4" /></button>
    </div>
  </section>

  <!-- Step 3: Customer Info -->
  <section data-step-panel="3" class="hidden card-surface p-6 sm:p-8">
    <h2 class="font-heading text-xl font-bold text-rc-white mb-6">Your Information</h2>
    <form id="bk-info-form" class="grid sm:grid-cols-2 gap-5">
      <div class="sm:col-span-2">
        <label for="bk-name" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Full Name *</label>
        <input id="bk-name" type="text" required class="form-input" autocomplete="name" />
      </div>
      <div>
        <label for="bk-mobile" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Mobile Number *</label>
        <input id="bk-mobile" type="tel" required class="form-input" autocomplete="tel" placeholder="09XX XXX XXXX" />
      </div>
      <div>
        <label for="bk-email" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Email Address *</label>
        <input id="bk-email" type="email" required class="form-input" autocomplete="email" />
      </div>
      <div>
        <label for="bk-city" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">City / Address</label>
        <input id="bk-city" type="text" class="form-input" autocomplete="address-level2" />
      </div>
      <div>
        <label for="bk-contact-method" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Preferred Contact Method</label>
        <select id="bk-contact-method" class="form-input">
          <option>Mobile Call</option>
          <option>SMS</option>
          <option>Email</option>
          <option>Facebook Messenger</option>
        </select>
      </div>
      <div class="sm:col-span-2">
        <label for="bk-requests" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Special Requests</label>
        <textarea id="bk-requests" rows="3" class="form-input resize-none" placeholder="Anything else we should know?"></textarea>
      </div>
    </form>
    <div class="flex justify-between mt-8">
      <button type="button" class="btn-ghost" data-step-back data-ripple>Back</button>
      <button type="button" class="btn-primary" data-step-next data-ripple>Continue <Icon name="arrow" class="w-4 h-4" /></button>
    </div>
  </section>

  <!-- Step 4: Review -->
  <section data-step-panel="4" class="hidden card-surface p-6 sm:p-8">
    <h2 class="font-heading text-xl font-bold text-rc-white mb-6">Review Your Reservation</h2>
    <div id="bk-review"></div>

    <div class="mt-7 rounded-lg bg-white/5 border border-white/10 px-4 py-4 text-xs text-rc-silver-dark space-y-2">
      <p><strong class="text-rc-white">Deposit:</strong> A deposit may be requested to secure certain bookings (placeholder — confirm official deposit policy).</p>
      <p><strong class="text-rc-white">Cancellation:</strong> Free cancellation up to 24 hours before your session. See our <a href="/cancellation-policy" class="text-rc-lime underline underline-offset-4" target="_blank">Cancellation & Rescheduling Policy</a>.</p>
    </div>

    <label class="flex items-start gap-3 text-sm text-rc-silver mt-6">
      <input type="checkbox" id="bk-terms" class="mt-1 w-4 h-4 rounded border-white/30 bg-white/5 text-rc-lime focus:ring-rc-lime" />
      <span>I agree to the <a href="/terms" target="_blank" class="text-rc-lime underline underline-offset-4">Terms and Conditions</a> and <a href="/cancellation-policy" target="_blank" class="text-rc-lime underline underline-offset-4">Cancellation Policy</a>. *</span>
    </label>

    <div class="flex justify-between mt-8">
      <button type="button" class="btn-ghost" data-step-back data-ripple>Back</button>
      <button type="button" class="btn-primary" data-step-next data-ripple>Review Complete <Icon name="arrow" class="w-4 h-4" /></button>
    </div>
  </section>

  <!-- Step 5: Submit -->
  <section data-step-panel="5" class="hidden card-surface p-6 sm:p-8 text-center">
    <div id="bk-submit-idle">
      <h2 class="font-heading text-xl font-bold text-rc-white mb-3">Ready to Submit</h2>
      <p class="text-sm text-rc-silver-dark mb-7 max-w-md mx-auto">Your reservation will be submitted with <strong class="text-amber-300">Pending Confirmation</strong> status. Our team will verify availability and confirm shortly.</p>
      <button type="button" id="bk-submit" class="btn-primary" data-ripple>Submit Reservation</button>
    </div>

    <div id="bk-submit-loading" class="hidden py-6">
      <div class="w-12 h-12 mx-auto border-4 border-rc-lime/30 border-t-rc-lime rounded-full animate-spin"></div>
      <p class="text-sm text-rc-silver-dark mt-4">Submitting your reservation…</p>
    </div>

    <div id="bk-submit-success" class="hidden">
      <div class="w-16 h-16 mx-auto rounded-full bg-rc-lime/15 border-2 border-rc-lime flex items-center justify-center mb-5 success-pop">
        <Icon name="check" class="w-7 h-7 text-rc-lime" />
      </div>
      <h2 class="font-heading text-xl font-bold text-rc-white mb-2">Reservation Received!</h2>
      <p class="text-sm text-rc-silver-dark mb-2">Reference Number</p>
      <p id="bk-reference" class="font-display text-2xl text-rc-lime font-bold mb-6">—</p>
      <span class="inline-block px-3 py-1 rounded-full bg-amber-400/15 border border-amber-400/40 text-amber-300 text-xs font-heading font-bold uppercase mb-7">Pending Confirmation</span>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/booking-confirmation" class="btn-primary" data-ripple>View Full Confirmation</a>
        <a href="/contact" class="btn-ghost" data-ripple>Contact Us</a>
      </div>
    </div>

    <div id="bk-submit-error" class="hidden">
      <div class="w-16 h-16 mx-auto rounded-full bg-red-500/15 border-2 border-red-500/50 flex items-center justify-center mb-5">
        <Icon name="info" class="w-7 h-7 text-red-400" />
      </div>
      <h2 class="font-heading text-xl font-bold text-rc-white mb-2">Something Went Wrong</h2>
      <p class="text-sm text-rc-silver-dark mb-6">We couldn't submit your reservation. Please try again, or contact us directly.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <button type="button" id="bk-retry" class="btn-primary" data-ripple>Try Again</button>
        <a href="/contact" class="btn-ghost" data-ripple>Contact Us</a>
      </div>
    </div>
  </section>
</div>

<style is:global>
  /* Global (not scoped): several elements below — .slot-btn, .bk-addon-card,
     the review <dl>, etc. — are created dynamically via document.createElement
     / innerHTML in booking-form.ts. Astro's scoped styles rewrite selectors
     with a data-astro-cid attribute that is only ever applied to elements
     present in this component's own template, so a scoped style here would
     silently fail to match anything built at runtime. */
  #booking-form-root .form-input {
    @apply w-full min-h-[44px] rounded-lg bg-white/5 border border-white/15 px-3.5 text-sm text-rc-white focus:outline-none focus:border-rc-lime transition-colors;
  }
  .slot-btn {
    @apply min-h-[44px] rounded-lg border border-white/15 bg-white/5 text-xs font-heading font-semibold text-rc-silver flex flex-col items-center justify-center gap-0.5 transition-colors relative;
  }
  .slot-btn:hover:not(:disabled) { @apply border-rc-lime/50 text-rc-white; }
  .slot-selected { @apply !bg-rc-lime !text-rc-black !border-rc-lime; }
  .slot-unavailable { @apply opacity-30 cursor-not-allowed line-through; }
  .slot-peak:not(.slot-selected)::after {
    content: '';
    position: absolute;
    top: 4px; right: 4px;
    width: 6px; height: 6px;
    border-radius: 999px;
    background: theme('colors.rc-purple-light');
  }
  .slot-next-day { @apply text-[9px] text-rc-lime/70 normal-case; }
  .bk-badge {
    @apply inline-flex items-center px-3 py-1.5 rounded-full text-xs font-heading font-bold uppercase tracking-wide h-fit;
  }
  .bk-badge-peak { @apply bg-rc-purple/20 border border-rc-purple/40 text-rc-purple-light; }
  .bk-badge-offpeak { @apply bg-rc-lime/10 border border-rc-lime/30 text-rc-lime; }
  .bk-radio-card {
    @apply flex items-center gap-2 text-sm text-rc-silver rounded-lg border border-white/10 px-3 py-2.5 cursor-pointer hover:border-rc-lime/40 transition-colors;
  }
  .bk-radio-card:has(input:checked) { @apply border-rc-lime bg-rc-lime/10 text-rc-white; }
  .bk-addon-card {
    @apply flex items-start gap-3 text-sm text-rc-silver rounded-lg border border-white/10 px-4 py-3 cursor-pointer hover:border-rc-purple/40 transition-colors;
  }
  .bk-addon-card:has(input:checked) { @apply border-rc-purple bg-rc-purple/10; }
  .bk-dot.bk-dot-active { @apply bg-rc-lime border-rc-lime text-rc-black; }
  .bk-dot.bk-dot-done { @apply bg-rc-purple border-rc-purple text-white; }
  .bk-review-label { @apply text-rc-silver-dark text-xs uppercase tracking-wide; }
  .bk-review-value { @apply text-rc-white mt-0.5; }
  .success-pop { animation: successPop 0.6s cubic-bezier(.34,1.56,.64,1); }
  @keyframes successPop {
    0% { transform: scale(0); opacity: 0; }
    70% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .success-pop { animation: none; }
  }
</style>

<script define:vars={{ addons }}>
  window.__RC_BOOKING_ADDONS__ = addons;
</script>
<script>
  import { initBookingForm } from '../lib/client/booking-form';
  const addons = (window as any).__RC_BOOKING_ADDONS__ || [];
  initBookingForm(addons);
</script>
