---
import { getCollection } from 'astro:content';
const settingsEntries = await getCollection('settings');
const settings = settingsEntries[0].data;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const hideOn = ['/book', '/admin'];
const shouldRender = !hideOn.some((p) => currentPath.startsWith(p));
---
{shouldRender && (
  <div
    id="sticky-booking-bar"
    class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-rc-black/95 backdrop-blur-md border-t border-white/10 px-4 py-3 flex items-center gap-3"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  >
    <a
      href={`tel:${settings.contact.mobile.replace(/\s+/g, '')}`}
      class="w-11 h-11 shrink-0 flex items-center justify-center rounded-full border border-white/15 text-rc-white"
      aria-label="Call RC Rally Hub"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.7A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 2 .7 3a2 2 0 01-.5 2.1L8 10a16 16 0 006 6l1.2-1.3a2 2 0 012.1-.5c1 .4 2 .6 3 .7a2 2 0 011.7 2z"/></svg>
    </a>
    <a href="/book" class="btn-primary flex-1 !py-3" data-ripple>
      {settings.bookingButtonText}
    </a>
  </div>
)}
