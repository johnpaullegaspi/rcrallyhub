---
// Netlify Forms: this must remain a real, static <form> with the
// `data-netlify="true"` (or `netlify`) attribute and a matching
// `form-name` hidden input so Netlify's build-time bot can detect it —
// see README → "Netlify Forms Setup". JS below only progressively
// enhances submission (AJAX + animated states); the form still works
// with plain HTML if JS fails to load.
---
<form
  id="contact-form"
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="company"
  class="space-y-5"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>Don't fill this out if you're human: <input name="company" /></label>
  </p>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="cf-name" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Full Name *</label>
      <input id="cf-name" name="name" type="text" required class="form-input" autocomplete="name" />
    </div>
    <div>
      <label for="cf-mobile" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Mobile Number *</label>
      <input id="cf-mobile" name="mobile" type="tel" required class="form-input" autocomplete="tel" placeholder="09XX XXX XXXX" />
    </div>
  </div>

  <div>
    <label for="cf-email" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Email Address *</label>
    <input id="cf-email" name="email" type="email" required class="form-input" autocomplete="email" />
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="cf-inquiry" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Inquiry Type *</label>
      <select id="cf-inquiry" name="inquiryType" required class="form-input">
        <option value="">Select one…</option>
        <option>Court Booking</option>
        <option>Rates & Packages</option>
        <option>Tournaments & Events</option>
        <option>Private Event / Corporate</option>
        <option>Coaching</option>
        <option>General Question</option>
        <option>Other</option>
      </select>
    </div>
    <div>
      <label for="cf-contact-method" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Preferred Contact Method *</label>
      <select id="cf-contact-method" name="preferredContactMethod" required class="form-input">
        <option value="">Select one…</option>
        <option>Mobile Call</option>
        <option>SMS</option>
        <option>Email</option>
        <option>Facebook Messenger</option>
      </select>
    </div>
  </div>

  <div>
    <label for="cf-message" class="block text-xs font-heading uppercase tracking-wide text-rc-silver-dark mb-1.5">Message *</label>
    <textarea id="cf-message" name="message" rows="4" required class="form-input resize-none"></textarea>
  </div>

  <label class="flex items-start gap-3 text-sm text-rc-silver-dark">
    <input type="checkbox" name="privacyConsent" required class="mt-1 w-4 h-4 rounded border-white/30 bg-white/5 text-rc-lime focus:ring-rc-lime" />
    <span>I agree to the <a href="/privacy" class="text-rc-lime underline underline-offset-4">Privacy Policy</a> and consent to RC Rally Hub contacting me about my inquiry. *</span>
  </label>

  <button type="submit" id="contact-submit" class="btn-primary w-full" data-ripple>
    <span id="contact-submit-label">Send Inquiry</span>
  </button>

  <div id="contact-success" class="hidden items-center gap-3 rounded-xl border border-rc-lime/40 bg-rc-lime/10 px-5 py-4 text-sm text-rc-lime" role="status">
    <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Thanks! Your message has been sent — our team will get back to you soon.
  </div>
  <div id="contact-error" class="hidden items-center gap-3 rounded-xl border border-red-500/40 bg-red-500/10 px-5 py-4 text-sm text-red-300" role="alert">
    <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4m0 4h.01M22 12a10 10 0 11-20 0 10 10 0 0120 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Something went wrong sending your message. Please try again, or contact us directly.
  </div>
</form>

<style>
  .form-input {
    @apply w-full min-h-[48px] rounded-lg bg-white/5 border border-white/15 px-4 text-sm text-rc-white placeholder:text-rc-silver-dark focus:outline-none focus:border-rc-lime transition-colors;
  }
  .form-input:invalid[data-touched="true"] {
    @apply border-red-500/60;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
  const submitLabel = document.getElementById('contact-submit-label') as HTMLElement;
  const successEl = document.getElementById('contact-success') as HTMLElement;
  const errorEl = document.getElementById('contact-error') as HTMLElement;

  form?.querySelectorAll('input, select, textarea').forEach((el) => {
    el.addEventListener('blur', () => el.setAttribute('data-touched', 'true'));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    errorEl.classList.remove('flex');
    successEl.classList.add('hidden');
    successEl.classList.remove('flex');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitBtn.disabled = true;
    submitLabel.textContent = 'Sending…';

    try {
      const formData = new FormData(form);
      const body = new URLSearchParams(formData as any).toString();
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      if (!res.ok) throw new Error('Network error');
      successEl.classList.remove('hidden');
      successEl.classList.add('flex');
      form.reset();
    } catch (err) {
      errorEl.classList.remove('hidden');
      errorEl.classList.add('flex');
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Send Inquiry';
    }
  });
</script>
