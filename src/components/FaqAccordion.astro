---
interface Faq { question: string; answer: string; category: string }
interface Props { faqs: Faq[] }
const { faqs } = Astro.props;
const categories = Array.from(new Set(faqs.map((f) => f.category)));
---
<div data-faq-root>
  <div class="relative max-w-xl mx-auto mb-10 reveal">
    <label for="faq-search" class="sr-only">Search FAQs</label>
    <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-rc-silver-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4a7 7 0 100 14 7 7 0 000-14zM21 21l-4.3-4.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <input
      id="faq-search"
      type="search"
      placeholder="Search FAQs — e.g. “midnight booking”, “rates”, “equipment”…"
      class="w-full min-h-[48px] rounded-full bg-white/5 border border-white/15 pl-12 pr-4 text-sm text-rc-white placeholder:text-rc-silver-dark focus:outline-none focus:border-rc-lime"
    />
  </div>

  <div class="flex flex-wrap justify-center gap-2 mb-12 reveal" role="tablist" aria-label="FAQ categories">
    <button type="button" class="faq-filter-btn active" data-category="all">All</button>
    {categories.map((cat) => (
      <button type="button" class="faq-filter-btn" data-category={cat}>{cat}</button>
    ))}
  </div>

  <div id="faq-no-results" class="hidden text-center text-rc-silver-dark py-10">
    No FAQs match your search. Try a different keyword, or <a href="/contact" class="text-rc-lime underline underline-offset-4">contact us</a> directly.
  </div>

  <div class="max-w-3xl mx-auto space-y-3" id="faq-list">
    {faqs.map((faq, i) => (
      <div
        class="faq-item reveal border border-white/10 rounded-xl overflow-hidden bg-rc-charcoal/60"
        data-category={faq.category}
        data-question={faq.question.toLowerCase()}
        data-answer={faq.answer.toLowerCase()}
        data-reveal-delay={(i % 8) * 40}
      >
        <h3 class="m-0">
          <button
            type="button"
            class="faq-trigger w-full flex items-center justify-between gap-4 text-left px-5 py-4 min-h-[44px]"
            aria-expanded="false"
          >
            <span class="font-heading font-semibold text-rc-white">{faq.question}</span>
            <svg class="faq-chevron w-5 h-5 text-rc-lime shrink-0 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </h3>
        <div class="faq-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
          <div class="overflow-hidden">
            <p class="px-5 pb-5 text-sm text-rc-silver leading-relaxed">{faq.answer}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .faq-filter-btn {
    @apply px-4 py-2 rounded-full text-xs font-heading font-bold uppercase tracking-wide border border-white/15 text-rc-silver transition-colors;
    min-height: 40px;
  }
  .faq-filter-btn.active,
  .faq-filter-btn:hover {
    @apply border-rc-lime text-rc-lime bg-rc-lime/10;
  }
  .faq-item[data-open="true"] .faq-panel {
    grid-template-rows: 1fr;
  }
  .faq-item[data-open="true"] .faq-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const root = document.querySelector('[data-faq-root]');
  const searchInput = document.getElementById('faq-search') as HTMLInputElement;
  const filterBtns = root?.querySelectorAll<HTMLButtonElement>('.faq-filter-btn');
  const items = root?.querySelectorAll<HTMLElement>('.faq-item');
  const noResults = document.getElementById('faq-no-results');
  let activeCategory = 'all';

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;
    items?.forEach((item) => {
      const matchesCategory = activeCategory === 'all' || item.dataset.category === activeCategory;
      const matchesQuery = !query || item.dataset.question?.includes(query) || item.dataset.answer?.includes(query);
      const show = matchesCategory && matchesQuery;
      item.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    });
    noResults?.classList.toggle('hidden', visibleCount > 0);
  }

  searchInput?.addEventListener('input', applyFilters);

  filterBtns?.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.dataset.category || 'all';
      applyFilters();
    });
  });

  items?.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
    trigger?.addEventListener('click', () => {
      const isOpen = item.dataset.open === 'true';
      item.dataset.open = String(!isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // Support deep-linking via ?q= search param (e.g. from chatbot / footer search)
  const params = new URLSearchParams(window.location.search);
  const q = params.get('q');
  if (q && searchInput) {
    searchInput.value = q;
    applyFilters();
  }
</script>
