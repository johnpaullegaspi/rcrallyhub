---
import { getCollection } from 'astro:content';
import EventCard from '../EventCard.astro';

const events = (await getCollection('events'))
  .filter((e) => e.data.published)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 6);
---
<section class="py-24 sm:py-28">
  <div class="container-rc">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-14 reveal">
      <div>
        <p class="eyebrow mb-5">What's Coming Up</p>
        <h2 class="section-heading">Upcoming Events</h2>
      </div>
      <a href="/events" class="text-rc-lime font-heading font-bold uppercase text-sm tracking-wide flex items-center gap-2 hover:gap-3 transition-all">
        View all events
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {events.map((event, i) => (
        <EventCard
          slug={event.slug}
          title={event.data.title}
          image={event.data.image}
          imageAlt={event.data.imageAlt}
          excerpt={event.data.excerpt}
          date={event.data.date}
          startTime={event.data.startTime}
          endTime={event.data.endTime}
          category={event.data.category}
          skillLevel={event.data.skillLevel}
          fee={event.data.fee}
          availableSlots={event.data.availableSlots}
          maxParticipants={event.data.maxParticipants}
          status={event.data.status}
          index={i}
        />
      ))}
    </div>
  </div>
</section>
