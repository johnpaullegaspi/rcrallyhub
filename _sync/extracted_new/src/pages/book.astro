---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const pageEntries = await getCollection('pages');
const page = pageEntries.find((p) => p.slug === 'book')!;
const settingsEntries = await getCollection('settings');
const settings = settingsEntries[0].data;
---
<Layout
  title={page.data.seoTitle || page.data.title}
  description={page.data.metaDescription || page.data.description || ''}
  ogImage={page.data.ogImage}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Book a Court', url: '/book' }]}
>
  <PageHero heading={page.data.heading} subheading={page.data.subheading} description={page.data.description} heroImage={page.data.heroImage} heroImageAlt={page.data.heroImageAlt} compact />

  <section class="py-16 sm:py-20">
    <div class="container-rc">
      <div class="max-w-3xl mx-auto mb-10 grid sm:grid-cols-3 gap-4 reveal">
        <div class="card-surface p-4 text-center">
          <Icon name="clock" class="w-5 h-5 text-rc-lime mx-auto mb-2" />
          <p class="text-xs text-rc-silver">{settings.operatingHours}</p>
        </div>
        <div class="card-surface p-4 text-center">
          <Icon name="info" class="w-5 h-5 text-rc-lime mx-auto mb-2" />
          <p class="text-xs text-rc-silver">Bookings after midnight are fully supported</p>
        </div>
        <div class="card-surface p-4 text-center">
          <Icon name="check" class="w-5 h-5 text-rc-lime mx-auto mb-2" />
          <p class="text-xs text-rc-silver">Starts as Pending Confirmation</p>
        </div>
      </div>

      <div class="max-w-3xl mx-auto card-surface p-8 sm:p-10 text-center reveal">
        <span class="eyebrow mx-auto mb-4">Real-Time Availability</span>
        <h2 class="font-display text-2xl sm:text-3xl uppercase text-rc-white mb-3">Ready to Rally?</h2>
        <p class="text-sm sm:text-base text-rc-silver max-w-xl mx-auto mb-8">
          Booking happens on our secure booking system, where you'll see real-time court availability, pick your exact
          time slot, and submit your request. It only takes about a minute, and you'll get a confirmation the moment
          our team reviews it.
        </p>
        <a
          id="book-cta-link"
          href={settings.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary !px-10 !py-4 !text-base"
          data-ripple
        >
          Continue to Booking <Icon name="arrow" class="w-4 h-4" />
        </a>
        <p class="text-xs text-rc-silver-dark mt-4">Opens in a new tab — {settings.businessName} stays right here.</p>
      </div>

      <div class="max-w-3xl mx-auto mt-10 text-center text-xs text-rc-silver-dark reveal">
        <p>Have questions about how confirmation works? See our <a href="/faqs?q=confirmed" class="text-rc-lime underline underline-offset-4">FAQ on confirmation</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // If a visitor arrived here from a "quick check" widget elsewhere on the
  // site (e.g. the homepage hero) with a chosen date and/or party size,
  // carry those through to the booking system so they don't have to
  // re-enter them. Start time and duration are deliberately never part of
  // this handoff — those are picked on the booking system itself, against
  // real, live availability, since a value guessed here could already be
  // taken by the time the visitor gets there. A visitor who lands directly
  // on this page (no prior selections) just gets the plain link below, and
  // the booking system's normal empty-prefill state.
  const params = new URLSearchParams(window.location.search);
  const date = params.get('date');
  const players = params.get('players');
  const link = document.getElementById('book-cta-link') as HTMLAnchorElement | null;
  if (link) {
    try {
      const url = new URL(link.href);
      if (date && /^\d{4}-\d{2}-\d{2}$/.test(date)) {
        url.searchParams.set('date', date);
      }
      const playersNum = players ? Number(players) : NaN;
      if (Number.isInteger(playersNum) && playersNum >= 1 && playersNum <= 50) {
        url.searchParams.set('players', String(playersNum));
      }
      link.href = url.toString();
    } catch {
      // settings.bookingUrl isn't a valid absolute URL yet (still the
      // placeholder) — leave the link as-is rather than breaking it.
    }
  }
</script>
