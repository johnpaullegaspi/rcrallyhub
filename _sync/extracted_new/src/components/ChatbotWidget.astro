---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const chatbotEntries = await getCollection('chatbot');
const chatbot = chatbotEntries[0].data;
const faqEntries = (await getCollection('faqs')).filter((f) => f.data.published && f.data.useAsChatbotAnswer);
const settingsEntries = await getCollection('settings');
const settings = settingsEntries[0].data;

const faqData = faqEntries.map((f) => ({ question: f.data.question, answer: f.data.answer, category: f.data.category }));
const businessData = {
  businessName: settings.businessName,
  address: settings.address,
  locationDescription: settings.locationDescription,
  operatingHours: settings.operatingHours,
  contact: {
    mobile: settings.contact.mobile,
    email: settings.contact.email,
    facebook: settings.contact.facebook,
  },
};
---
{chatbot.enabled && (
  <div id="rally-assistant" class="fixed z-40 bottom-[calc(5.5rem+env(safe-area-inset-bottom))] right-4 sm:bottom-6 sm:right-6">
    <!-- Launcher -->
    <button
      id="chatbot-launcher"
      type="button"
      aria-expanded="false"
      aria-controls="chatbot-panel"
      aria-label={`Open ${chatbot.chatbotName} chat`}
      class="relative w-16 h-16 rounded-full bg-rc-gradient shadow-glow-purple border border-white/10 flex items-center justify-center text-rc-white hover:scale-105 active:scale-95 transition-transform duration-200"
    >
      <Icon name="bot" class="w-7 h-7" />
      <span id="chatbot-badge" class="hidden absolute -top-1 -right-1 w-5 h-5 rounded-full bg-rc-lime border-2 border-rc-black animate-pulse-glow" aria-hidden="true"></span>
      <span class="sr-only">Open chat with {chatbot.chatbotName}</span>
    </button>

    <!-- Panel -->
    <div
      id="chatbot-panel"
      role="dialog"
      aria-modal="false"
      aria-label={`${chatbot.chatbotName} chat window`}
      class="pointer-events-none opacity-0 translate-y-4 scale-95 origin-bottom-right transition-all duration-250 fixed left-3 right-3 top-[max(0.75rem,env(safe-area-inset-top))] bottom-[calc(5.5rem+env(safe-area-inset-bottom))] sm:absolute sm:top-auto sm:left-auto sm:right-0 sm:bottom-20 sm:w-[380px] sm:h-[70vh] sm:max-h-[560px] flex flex-col rounded-2xl border border-white/10 bg-rc-charcoal shadow-card overflow-hidden"
    >
      <div class="flex items-center justify-between px-4 py-3 bg-rc-gradient shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-black/25 flex items-center justify-center">
            <Icon name="bot" class="w-5 h-5 text-rc-lime" />
          </div>
          <div class="leading-tight">
            <p class="font-heading font-bold text-sm text-white">{chatbot.chatbotName}</p>
            <p class="text-[11px] text-white/70 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-rc-lime inline-block"></span> Online</p>
          </div>
        </div>
        <div class="flex items-center gap-1">
          <button id="chatbot-minimize" type="button" aria-label="Minimize chat" class="w-8 h-8 flex items-center justify-center rounded-full text-white/80 hover:bg-white/10">
            <Icon name="minus" class="w-4 h-4" />
          </button>
          <button id="chatbot-close" type="button" aria-label="Close chat" class="w-8 h-8 flex items-center justify-center rounded-full text-white/80 hover:bg-white/10">
            <Icon name="close" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <div id="chatbot-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-3" role="log" aria-live="polite"></div>

      <div id="chatbot-quick-replies" class="px-3 py-2 flex flex-wrap gap-2 border-t border-white/10 shrink-0 max-h-24 overflow-y-auto">
        {chatbot.quickReplies.map((q) => (
          <button
            type="button"
            data-intent={q.intent}
            data-label={q.label}
            class="text-xs font-heading font-semibold px-3 py-1.5 rounded-full border border-rc-purple/50 text-rc-silver hover:border-rc-lime hover:text-rc-lime transition-colors"
          >
            {q.label}
          </button>
        ))}
      </div>

      <div class="px-3 py-3 border-t border-white/10 shrink-0 space-y-2">
        <form id="chatbot-form" class="flex items-center gap-2">
          <label for="chatbot-input" class="sr-only">Type your message</label>
          <input
            id="chatbot-input"
            type="text"
            autocomplete="off"
            placeholder="Type your question…"
            class="flex-1 min-h-[44px] rounded-full bg-white/5 border border-white/15 px-4 text-sm text-rc-white placeholder:text-rc-silver-dark focus:outline-none focus:border-rc-lime"
          />
          <button type="submit" aria-label="Send message" class="w-11 h-11 shrink-0 rounded-full bg-rc-lime text-rc-black flex items-center justify-center hover:bg-rc-lime-light">
            <Icon name="send" class="w-4 h-4" />
          </button>
        </form>
        <div class="flex items-center justify-center gap-3 text-[11px] text-rc-silver-dark">
          {chatbot.contactActions.map((a) => (
            <a href={a.value} target={a.type === 'facebook' ? '_blank' : undefined} rel={a.type === 'facebook' ? 'noopener noreferrer' : undefined} class="hover:text-rc-lime transition-colors underline underline-offset-2">
              {a.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
)}

<script define:vars={{ chatbotConfig: chatbot, faqData, businessData }}>
  window.__RC_CHATBOT_CONFIG__ = chatbotConfig;
  window.__RC_CHATBOT_FAQS__ = faqData;
  window.__RC_CHATBOT_SETTINGS__ = businessData;
</script>
<script>
  import { initChatbot } from '../lib/client/chatbot';
  const config = (window as any).__RC_CHATBOT_CONFIG__;
  const faqs = (window as any).__RC_CHATBOT_FAQS__;
  const settings = (window as any).__RC_CHATBOT_SETTINGS__;
  if (config) initChatbot(config, faqs, settings);
</script>

<style is:global>
  /* Global: .typing-dot elements are injected dynamically by chatbot.ts,
     so they never receive Astro's scoped data-astro-cid attribute. */
  #rally-assistant .typing-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: theme('colors.rc-lime');
    animation: typingBounce 1s infinite ease-in-out;
  }
  .typing-dot:nth-child(2) { animation-delay: 0.15s; }
  .typing-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
</style>
